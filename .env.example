# COSKO MULTI-STORE ENTERPRISE SYSTEM — ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# For Netlify / Multi-Device Cloud Production:
# The database MUST be a hosted, internet-accessible MySQL database (e.g., Aiven, PlanetScale, Railway, AWS RDS, or DigitalOcean)
# A local MySQL database (localhost:3306) on a developer's laptop will NOT be reachable from Netlify or mobile devices.

# 1. Authoritative MySQL Database Connection String
# Regional Colocation Note (p95 latency < 150ms):
# Host the database in the SAME cloud region as Next.js hosting (e.g., AWS ap-south-1 Mumbai).
# Recommended flags: connection_limit=25&pool_timeout=30&connect_timeout=10
DATABASE_URL="mysql://cosko_user:Cosko2026_SecurePass@cosko-mysql.ap-south-1.rds.amazonaws.com:3306/cosko_db?sslaccept=strict&connection_limit=25&pool_timeout=30"

# 2. Server Secret Key for Session Signatures & JWT Auth Tokens (Must be a 32+ character random string)
AUTH_SECRET="your-32-character-random-secret-key-for-session-tokens"

# 3. Application Public Base URL
NEXT_PUBLIC_APP_URL="https://cosko.netlify.app"

# 4. S3-Compatible Object Storage Credentials (Cloudflare R2 / AWS S3 / MinIO)
# Accepts either STORAGE_* or R2_* variable names:
STORAGE_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="cosko-assets"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"

# Cloudflare R2 specific aliases (supported natively):
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# R2_BUCKET_NAME="cosko-payment-proofs"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"

# 5. Distributed Realtime Pub-Sub (Pusher Channels for Netlify / Serverless Multi-Instance)
# Required for multi-device instant WebSocket sync across serverless instances.
# When configured:
# - Uses authenticated private channels: private-store-<storeCode>, private-user-<userId>,
#   private-enterprise, private-attendance, and private-work-activity.
# - Channel authorization endpoint: POST /api/realtime/auth
# - Cross-store subscription attempts by non-Super-Admin are rejected with HTTP 403.
# If omitted or unconfigured, the system safely operates in DB-authoritative fallback sync mode
# (polling outbox cursors). Note: when unconfigured, distributed WebSocket realtime is not active.
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-app-key"
PUSHER_SECRET="your-pusher-app-secret"
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
