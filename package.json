{
  "name": "storecommand",
  "version": "0.1.0",
  "private": true,
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@dhiwise/component-tagger",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": "🚨 CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "dev": "next dev -p 4028",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 4028",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start -p 4028",
    "type-check": "npm run type-check:all",
    "type-check:app": "tsc --noEmit",
    "type-check:tests": "tsc --noEmit --project tsconfig.tests.json",
    "type-check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "type-check:all": "npm run type-check:app && npm run type-check:tests && npm run type-check:scripts",
    "seed": "npx tsx scripts/seed-mysql.ts",
    "test": "npm run test:all",
    "test:security": "npx tsx --env-file=.env scripts/run-security-tests.ts",
    "test:phase1": "npx tsx tests/phase1-security.test.ts",
    "test:matrix": "npx tsx tests/phase1-security-matrix.ts",
    "test:phase2": "npx tsx tests/phase2.test.ts",
    "test:phase2-realtime": "npx tsx tests/phase2-realtime.test.ts",
    "test:phase3": "npx tsx tests/phase3.test.ts",
    "test:deep": "npx tsx tests/phase3-deep-verification.test.ts",
    "test:phase4": "npx tsx tests/phase4-security-closure.test.ts",
    "test:final-phase2": "npx tsx tests/final-closure-phase2.test.ts",
    "test:responsive": "npx tsx tests/responsive-form-modal.test.ts",
    "test:hotfix": "npx tsx tests/four-issue-hotfix.test.ts",
    "test:closure": "npx tsx tests/final-closure-proof-whatsapp.test.ts",
    "init:sequences": "npx tsx scripts/migrate-remediation-tables.ts",
    "test:concurrent-sequence": "npx tsx scripts/test-concurrent-sequence.ts",
    "test:password-policy": "npx tsx scripts/test-password-policy.ts",
    "test:latency-benchmark": "npx tsx scripts/test-latency-benchmark.ts",
    "test:password-reset": "npx tsx scripts/test-password-reset.ts",
    "test:remediation": "npx tsx tests/remediation.test.ts",
    "test:load-1000-concurrent": "npx tsx scripts/test-load-1000-concurrent.ts",
    "test:all": "npx tsx tests/phase1-security.test.ts && npx tsx tests/phase1-security-matrix.ts && npx tsx tests/phase2.test.ts && npx tsx tests/phase2-realtime.test.ts && npx tsx tests/phase3.test.ts && npx tsx tests/phase3-deep-verification.test.ts && npx tsx tests/phase4-security-closure.test.ts && npx tsx tests/final-closure-phase2.test.ts && npx tsx tests/responsive-form-modal.test.ts && npx tsx tests/four-issue-hotfix.test.ts && npx tsx tests/final-closure-proof-whatsapp.test.ts && npx tsx tests/remediation.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@dhiwise/component-tagger": "^1.0.16",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.7.0",
    "next": "15.5.18",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "react-hook-form": "^7.85.0",
    "recharts": "^2.15.2",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "8.4.8",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
